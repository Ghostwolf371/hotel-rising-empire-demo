# Copy to `.env` for local development.

# Neon Postgres connection string. Get one from https://console.neon.tech
# → your project → Dashboard → Connection details. Prefer the **pooled** URL
# (host contains "-pooler") so concurrent Server Actions share a connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?channel_binding=require&sslmode=require"

# Staff portal login at /management (required for management access).
# Env credentials always grant full super-admin access.
MANAGEMENT_EMAIL=admin@empire.sr
MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# REQUIRED in production (Vercel): signs staff session cookies. Min 32 chars.
# Local dev uses a fallback when unset. Generate: openssl rand -hex 32
MANAGEMENT_SESSION_SECRET=

# Optional in production: separate secret for guest kiosk device cookies.
# Falls back to MANAGEMENT_SESSION_SECRET when unset.
GUEST_DEVICE_SECRET=

# Required in production: all /api/v1/* routes validate this Bearer token.
# Leave unset in local dev to skip auth (see lib/server/api-auth.ts).
HRE_API_SECRET=

# When true, guest + management UIs load and persist domain data via Prisma
# (Server Actions). Requires DATABASE_URL and `npx prisma migrate dev` +
# `npx prisma db seed`. Also enables ~3 s polling on /management/* so the
# room grid + order/session popups update from the tablet without refresh.
HRE_USE_DATABASE=true
